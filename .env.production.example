# Sao chép thành .env.production và thay toàn bộ giá trị REPLACE_* trước khi chạy.
BOOKSPACE_PORT=8080
BOOKSPACE_DATA_VOLUME=bookspace-production-data
BOOKSPACE_PUBLIC_ORIGIN=https://bookspace.example.com
BOOKSPACE_JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_BYTES
BOOKSPACE_OPERATOR_NAME=REPLACE_LEGAL_OPERATOR_NAME
BOOKSPACE_SUPPORT_EMAIL=support@bookspace.example.com

# SMTP là bắt buộc trong production để luồng quên mật khẩu hoạt động thật.
BOOKSPACE_SMTP_HOST=smtp.example.com
BOOKSPACE_SMTP_PORT=587
BOOKSPACE_SMTP_ENABLE_SSL=true
BOOKSPACE_SMTP_USERNAME=REPLACE_SMTP_USERNAME
BOOKSPACE_SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
BOOKSPACE_SMTP_FROM_ADDRESS=no-reply@bookspace.example.com
BOOKSPACE_SMTP_FROM_NAME=BookSpace

# Network này chỉ dành cho hai container BookSpace và được API tin cậy để đọc
# X-Forwarded-For từ web proxy. Đổi subnet nếu xung đột với hạ tầng hiện có; dùng
# prefix /16 đến /29 để đủ gateway cùng hai container API/web.
BOOKSPACE_DOCKER_SUBNET=10.253.0.0/24
