# Backend
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5080
BOOKSPACE_ConnectionStrings__DefaultConnection=Data Source=/app/data/bookspace.db
BOOKSPACE_Jwt__Issuer=BookSpace
BOOKSPACE_Jwt__Audience=BookSpace.Web
BOOKSPACE_Jwt__Secret=change-this-local-secret-to-at-least-32-characters
BOOKSPACE_Cors__AllowedOrigins__0=http://localhost:5173

# Password recovery. Log is local-development only; use Smtp in production.
BOOKSPACE_PasswordRecovery__TokenLifetimeMinutes=15
BOOKSPACE_PasswordRecovery__RequestCooldownSeconds=60
BOOKSPACE_PasswordRecovery__FrontendResetUrl=http://localhost:5173/reset-password
BOOKSPACE_PasswordRecovery__DeliveryMode=Log
# BOOKSPACE_PasswordRecovery__Smtp__Host=smtp.example.com
# BOOKSPACE_PasswordRecovery__Smtp__Port=587
# BOOKSPACE_PasswordRecovery__Smtp__EnableSsl=true
# BOOKSPACE_PasswordRecovery__Smtp__Username=
# BOOKSPACE_PasswordRecovery__Smtp__Password=
# BOOKSPACE_PasswordRecovery__Smtp__FromAddress=no-reply@example.com
# BOOKSPACE_PasswordRecovery__Smtp__FromName=BookSpace

# Optional Bookstore provider. BookSpace works when this is disabled.
BOOKSPACE_BookstoreIntegration__Enabled=false
BOOKSPACE_BookstoreIntegration__BaseUrl=http://host.docker.internal:8080/api
BOOKSPACE_BookstoreIntegration__StorefrontUrl=http://localhost:5173
BOOKSPACE_BookstoreIntegration__TimeoutSeconds=5

# Frontend
VITE_API_BASE_URL=http://localhost:5080/api
