{
  "Urls": "http://0.0.0.0:5080",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/bookspace.db"
  },
  "Jwt": {
    "Issuer": "BookSpace",
    "Audience": "BookSpace.Web",
    "Secret": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "SeedData": {
    "Enabled": false
  },
  "RateLimiting": {
    "Authentication": {
      "Login": {
        "PermitLimit": 5,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6
      },
      "Refresh": {
        "PermitLimit": 20,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6
      }
    }
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "BookstoreIntegration": {
    "Enabled": false,
    "BaseUrl": "http://localhost:8080/api",
    "StorefrontUrl": "http://localhost:5173",
    "TimeoutSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
