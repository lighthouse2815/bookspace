# Môi trường chạy
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5080

# Các biến có tiền tố BOOKSPACE_ được nạp vào cấu hình .NET.
BOOKSPACE_Jwt__Issuer=BookSpace
BOOKSPACE_Jwt__Audience=BookSpace.Web
BOOKSPACE_Jwt__Secret=replace-with-a-random-secret-at-least-32-bytes
BOOKSPACE_Jwt__AccessTokenMinutes=30
BOOKSPACE_Jwt__RefreshTokenDays=14

# SQLite mặc định, không cần cài dịch vụ cơ sở dữ liệu.
BOOKSPACE_ConnectionStrings__DefaultConnection=Data Source=data/bookspace.db
BOOKSPACE_Cors__AllowedOrigins__0=http://localhost:5173
BOOKSPACE_SeedData__Enabled=true

# Tích hợp tùy chọn. BookSpace không cần Bookstore để khởi động hay hoạt động.
BOOKSPACE_BookstoreIntegration__Enabled=false
BOOKSPACE_BookstoreIntegration__BaseUrl=http://localhost:8080/api
BOOKSPACE_BookstoreIntegration__StorefrontUrl=http://localhost:5173
BOOKSPACE_BookstoreIntegration__TimeoutSeconds=5
